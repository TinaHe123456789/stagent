{
  "name": "stagent",
  "version": "0.1.0",
  "description": "Stagent — 已验收功能账本：记住系统由哪些已验收功能组成，以及它们是否仍然成立",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stagent": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "prepack": "npm run build",
    "dev:web": "vite --config web/vite.config.ts",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.12.7",
    "picomatch": "^4.0.7"
  }
}
